# 基础环境变量配置
set -Ux EDITOR nvim
set -Ux BROWSER zen-browser
{{- if not (env "WSL_DISTRO_NAME") }}
# SSH agent：仅原生 Linux（如 Arch）使用，指向 systemd 的 ssh-agent socket。
# WSL 下不设置：git 经 core.sshCommand = ~/bin/win-ssh 转发到 Windows 的 ssh.exe，
# 由 Windows 侧的 KeePassXC SSH agent 提供密钥；此处若设置，WSL 的 socket 路径会
# 被继承给 ssh.exe 并导致其找不到 agent（win-ssh.ps1 会主动清除该变量）。
# SSH agent: native Linux only (e.g. Arch), pointing at the systemd ssh-agent socket.
# Unset under WSL: git goes through core.sshCommand = ~/bin/win-ssh to the Windows
# ssh.exe, whose keys come from the Windows-side KeePassXC SSH agent. Setting it here
# would leak a Linux socket path into ssh.exe (win-ssh.ps1 clears it defensively).
set -gx SSH_AUTH_SOCK "$XDG_RUNTIME_DIR/ssh-agent.socket"
{{- end }}

# 添加本地二进制目录到 PATH（用户级工具，如 uv、codex 的安装位置）
fish_add_path ~/.local/bin

# fnm 默认安装目录（官方安装脚本）：优先 $XDG_DATA_HOME/fnm，未定义时回退 ~/.local/share/fnm
# fish_add_path 会自动跳过不存在的目录，故两条同时添加是安全的
fish_add_path "$XDG_DATA_HOME/fnm"
fish_add_path ~/.local/share/fnm

# pnpm 官方 standalone 脚本默认安装目录（$PNPM_HOME 默认 ~/.local/share/pnpm）；
# 可执行文件 pnpm/pn/pnpx/pnx 位于其 bin/ 子目录，fish 补全由 13-pnpm.fish 提供
# pnpm official standalone installer default dir ($PNPM_HOME defaults to ~/.local/share/pnpm);
# the CLIs (pnpm/pn/pnpx/pnx) live in its bin/ subdir, fish completions come from 13-pnpm.fish
set -gx PNPM_HOME "$HOME/.local/share/pnpm"
fish_add_path "$PNPM_HOME/bin"
{{- if env "WSL_DISTRO_NAME" }}
{{- $winHome := output "powershell.exe" "-NoProfile" "-NonInteractive" "-Command" "[Environment]::GetFolderPath('UserProfile')" | trim | replace "\\" "/" | replace "C:" "/mnt/c" }}
# DSH 技能库：指向 Windows 侧由 chezmoi/ccswitch 维护的共享技能目录。
# DSH 的 skill-filesystem 读取 $DSH_AGENTS_HOME/skills（rank 500），故设此变量后
# 无需在 ~/.dsh/skills 建软链接；~/.dsh/skills（rank 400）保持空闲，可放 WSL 本地技能。
# 仅 WSL 需要：原生 Linux 下不存在 /mnt/c 挂载，读该路径无意义。
# DSH skill library: points at the Windows-side shared skills maintained by
# chezmoi/ccswitch. DSH's skill-filesystem reads $DSH_AGENTS_HOME/skills (rank 500), so
# no symlink at ~/.dsh/skills is needed; that path (rank 400) stays free for WSL-local
# skills. WSL-only: a native Linux box has no /mnt/c mount to read from.
set -gx DSH_AGENTS_HOME "{{ $winHome }}/.agents"
{{- end }}
