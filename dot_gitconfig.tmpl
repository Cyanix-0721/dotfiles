[init]
	defaultBranch = main
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
[rerere]
	enabled = true
[pull]
	rebase = false
[user]
	name = {{ .name }}
	email = {{ .email }}
[core]
	pager = delta
{{- if eq .chezmoi.os "windows" }}
	autocrlf = true
	{{- /* winget 版 OpenSSH Preview 装在 Program Files，系统内置版在 System32；都没有则退回 PATH 解析。
	       路径含空格，须用单引号：git 配置文件里的双引号会被剥离，导致命令按空格切分 */}}
	{{- if stat "C:/Program Files/OpenSSH/ssh.exe" }}
	sshCommand = 'C:/Program Files/OpenSSH/ssh.exe'
	{{- else if stat "C:/Windows/System32/OpenSSH/ssh.exe" }}
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
	{{- else }}
	sshCommand = ssh.exe
	{{- end }}
{{- else }}
	autocrlf = input
	{{- if env "WSL_DISTRO_NAME" }}
	sshCommand = '{{ .chezmoi.homeDir }}/bin/win-ssh'
	{{- end }}
{{- end }}
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true  # use n and N to move between diff sections
	dark = true      # or light = true, or omit for auto-detection
[merge]
	conflictStyle = zdiff3
[credential]
{{- if eq .chezmoi.os "windows" }}
	helper = manager
{{- else }}
	{{- if stat "/usr/share/git/credential/libsecret/git-credential-libsecret" }}
		helper = /usr/share/git/credential/libsecret/git-credential-libsecret
	{{- else }}
		helper = cache --timeout=3600
	{{- end }}
{{- end }}
[http]
	connectTimeout = 3
	timeout = 0
	lowSpeedLimit = 1000
	lowSpeedTime = 30
[https]
	connectTimeout = 3
	timeout = 0
	lowSpeedLimit = 1000
	lowSpeedTime = 30
